    {
      "version": "0.18.1",
      "date": "Oct 24, 2026",
      "title": "A new front door",
      "items": [
        "New title screen: the gas giant turning in the sky, Ketter and Verra in orbit, ships coming and going.",
        "Continue shows your character, day, credits and where you left off.",
        "Save slots show your character too.",
        "The StarSide Launcher: install once, and it keeps the game up to date."
      ]
    },
    {
      "version": "0.18.0",
      "date": "Oct 23, 2026",
      "title": "Verra",
      "items": [
